{
  // Configuração do Cloudflare Workers.
  // src/worker.js força HTTPS; o conteúdo de ./public é servido como arquivos estáticos.
  "name": "rifa",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}
